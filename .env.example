# Copy to .env at the repository root. Restart dev after changing values.
PORT=8080
WAITING_TTL_MS=600000
ABSOLUTE_TTL_MS=3600000
VITE_PORT=5173
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_SIGNALING_URL=ws://localhost:8080
# Optional. Leave empty for local-only ICE without an external STUN service.
VITE_STUN_URL=
# Public STUN example (opt-in): stun:stun.l.google.com:19302
